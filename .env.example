# Legal Saathi - Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# LLM Providers (Optional for testing; fallback grounded synthesis works offline)
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_MODEL=local-grounded-synthesis
LLM_TIMEOUT_SECONDS=8.0

# Whisper AI (Speech-to-Text)
OPENAI_API_KEY=your_openai_or_whisper_api_key_here
WHISPER_MODEL=whisper-1

# Database
DATABASE_PATH=legal_saathi.db

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_TEXT_LENGTH=5000
