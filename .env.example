# ==============================================================================
# Legal Saathi - Unified Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - .env.local (for Next.js frontend development)
#   - .env       (for FastAPI backend development)
# DO NOT commit real secrets or credentials to source control.

# ==============================================================================
# 1. Frontend Configuration (Next.js)
# ==============================================================================
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STITCH_PROJECT_ID=16619462295473295197

# ==============================================================================
# 2. Backend Configuration (FastAPI)
# ==============================================================================
ENVIRONMENT=development
HOST=0.0.0.0
BACKEND_PORT=8000

# Security & CORS
SECRET_KEY=change_me_to_a_cryptographically_random_64_character_hex_key
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
MAX_AUDIO_UPLOAD_BYTES=26214400

# LLM Providers (Optional for testing; fallback grounded synthesis works 100% offline)
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_MODEL=local-grounded-synthesis
LLM_TIMEOUT_SECONDS=8.0

# Whisper AI (Speech-to-Text)
OPENAI_API_KEY=your_openai_or_whisper_api_key_here
WHISPER_MODEL=whisper-1

# Hugging Face (Required for gated datasets like vaquill/open-india-law)
HF_TOKEN=your_huggingface_read_token_here

# Database Persistence
DATABASE_PATH=legal_saathi.db

# Rate Limiting & Safety Bounds
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_TEXT_LENGTH=5000
